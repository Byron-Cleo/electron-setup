generator client {
  provider = "prisma-client"
  output   = "../db/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  userId            String   @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime
  User              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Cart {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?  @db.Uuid
  sessionCartId String
  items         Json[]   @default([]) @db.Json
  itemsPrice    Decimal  @db.Decimal(12, 2)
  totalPrice    Decimal  @db.Decimal(12, 2)
  shippingPrice Decimal  @db.Decimal(12, 2)
  taxPrice      Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime
  User          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Menu {
  id                                                    String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                                  String
  slug                                                  String                    @unique(map: "product_slug_idx")
  category                                              String
  images                                                String[]
  stock                                                 Int                       @default(0)
  price                                                 Decimal                   @default(0) @db.Decimal(12, 2)
  numReviews                                            Int                       @default(0)
  banner                                                String?
  createdAt                                             DateTime                  @default(now()) @db.Timestamp(6)
  hasStarch                                             Boolean                   @default(false)
  hasVegetable                                          Boolean                   @default(false)
  starchId                                              String?                   @db.Uuid
  vegetableId                                           String?                   @db.Uuid
  isAvailable                                           Boolean                   @default(true)
  cookingRecordMenus                                    CookingRecordMenu[]
  MenuAccompaniment_Menu_starchIdToMenuAccompaniment    MenuAccompaniment?        @relation("Menu_starchIdToMenuAccompaniment", fields: [starchId], references: [id])
  MenuAccompaniment_Menu_vegetableIdToMenuAccompaniment MenuAccompaniment?        @relation("Menu_vegetableIdToMenuAccompaniment", fields: [vegetableId], references: [id])
  MenuMealType                                          MenuMealType[]
  OrderItem                                             OrderItem[]
  Review                                                Review[]
  stockSupplyMenus                                      StockSupplyMenu[]
  snapshots                                             ShiftSnapshot[]
}

model MenuAccompaniment {
  id                                       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                     String
  description                              String?
  price                                    Decimal?          @db.Decimal(12, 2)
  image                                    String
  createdAt                                DateTime          @default(now()) @db.Timestamp(6)
  isDefault                                Boolean           @default(false)
  category                                 AccompanimentType
  Menu_Menu_starchIdToMenuAccompaniment    Menu[]            @relation("Menu_starchIdToMenuAccompaniment")
  Menu_Menu_vegetableIdToMenuAccompaniment Menu[]            @relation("Menu_vegetableIdToMenuAccompaniment")
  OrderItem_starchIdToMenuAccompaniment    OrderItem[]       @relation("OrderItem_starchIdToMenuAccompaniment")
  OrderItem_vegetableIdToMenuAccompaniment OrderItem[]       @relation("OrderItem_vegetableIdToMenuAccompaniment")
}

model Order {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber       Int         @unique @default(autoincrement())
  userId            String      @db.Uuid
  shippingAddress   Json        @db.Json
  paymentMethod     String
  paymentResult     Json?       @db.Json
  itemsPrice        Decimal     @db.Decimal(12, 2)
  shippingPrice     Decimal     @db.Decimal(12, 2)
  taxPrice          Decimal     @db.Decimal(12, 2)
  totalPrice        Decimal     @db.Decimal(12, 2)
  isPaid            Boolean     @default(false)
  paidAt            DateTime?   @db.Timestamp(6)
  isDelivered       Boolean     @default(false)
  deliveredAt       DateTime?   @db.Timestamp(6)
  createdAt         DateTime    @default(now()) @db.Timestamp(6)
  mealType          ServiceTime
  shiftId           String?     @db.Uuid
  isVoid            Boolean     @default(false)
  voidReason        String?
  voidedAt          DateTime?   @db.Timestamp(6)
  voidedById        String?     @db.Uuid
  voidedOrderId     String?     @db.Uuid
  paymentType       String?     // "SINGLE" or "BATCH"
  batchId           String?     // groups orders paid together in a batch
  User              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  OrderItem         OrderItem[]
  shift             Shift?      @relation(fields: [shiftId], references: [id])
  voidedBy          User?       @relation("VoidedBy", fields: [voidedById], references: [id])
  voidedOrder       Order?      @relation("VoidedFrom", fields: [voidedOrderId], references: [id])
  replacementOrders Order[]     @relation("VoidedFrom")
}

model OrderItem {
  id          Int                @id @default(autoincrement())
  orderId     String             @db.Uuid
  menuId      String             @db.Uuid
  qty         Int
  price       Decimal            @db.Decimal(12, 2)
  name        String
  slug        String
  image       String
  starchId    String?            @db.Uuid
  vegetableId String?            @db.Uuid
  Menu        Menu               @relation(fields: [menuId], references: [id], onDelete: Cascade)
  Order       Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  Starch      MenuAccompaniment? @relation("OrderItem_starchIdToMenuAccompaniment", fields: [starchId], references: [id])
  Vegetable   MenuAccompaniment? @relation("OrderItem_vegetableIdToMenuAccompaniment", fields: [vegetableId], references: [id])

  @@unique([orderId, menuId, starchId, vegetableId], map: "orderitems_order_menu_starch_veg_key")
}

model Review {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @db.Uuid
  menuId             String   @db.Uuid
  rating             Int
  title              String
  description        String
  isVerifiedPurchase Boolean  @default(true)
  createdAt          DateTime @default(now()) @db.Timestamp(6)
  Menu               Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  User               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  sessionToken String   @id
  userId       String   @db.Uuid
  expires      DateTime @db.Timestamp(6)
  createdAt    DateTime @default(now()) @db.Timestamp(6)
  updatedAt    DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String             @default("NO_NAME")
  email          String             @unique(map: "user_email_idx")
  emailVerified  DateTime?          @db.Timestamp(6)
  image          String?
  password       String?
  pin            String?
  role           String             @default("staff")
  isActive       Boolean            @default(true)
  platform       String?
  address        Json?              @db.Json
  paymentMethod  String?
  createdAt      DateTime           @default(now()) @db.Timestamp(6)
  updatedAt      DateTime
  Account        Account[]
  Cart           Cart[]
  cookingRecords CookingRecord[]
  Order          Order[]
  voidedOrders   Order[]            @relation("VoidedBy")
  openedShifts   Shift[]            @relation("ShiftOpenedBy")
  closedShifts   Shift[]            @relation("ShiftClosedBy")
  Review         Review[]
  Session        Session[]
  fulfillments   StockFulfillment[]
  StockRequest   StockRequest[]
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model MenuMealType {
  menuId   String      @db.Uuid
  mealType ServiceTime
  Menu     Menu        @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([menuId, mealType])
}

model StockSupply {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  slug                  String                  @unique
  description           String?
  unit                  ItemUnit
  currentStock          Decimal                 @default(0) @db.Decimal(12, 2)
  reorderLevel          Decimal?                @db.Decimal(12, 2)
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  platesPerUnit         Decimal?                @db.Decimal(12, 2)
  image                 String?
  isMenuStock           Boolean                 @default(false)
  costPrice             Decimal?                @db.Decimal(12, 2)
  CookingRecord         CookingRecord[]
  DepartmentStockSupply DepartmentStockSupply[]
  StockRequestItem      StockRequestItem[]
  menus                 StockSupplyMenu[]
}

model StockRequest {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestedById String             @db.Uuid
  department    String
  status        StockRequestStatus @default(PENDING)
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  fulfillments  StockFulfillment[]
  requestedBy   User               @relation(fields: [requestedById], references: [id])
  items         StockRequestItem[]
}

model StockRequestItem {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stockRequestId    String                 @db.Uuid
  stockSupplyId     String                 @db.Uuid
  quantityRequested Decimal                @db.Decimal(12, 2)
  quantityDelivered Decimal                @default(0) @db.Decimal(12, 2)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  fulfillmentItems  StockFulfillmentItem[]
  stockRequest      StockRequest           @relation(fields: [stockRequestId], references: [id], onDelete: Cascade)
  stockSupply       StockSupply            @relation(fields: [stockSupplyId], references: [id])
}

model Department {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  description           String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  DepartmentStockSupply DepartmentStockSupply[]
}

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DepartmentStockSupply {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  departmentId  String      @db.Uuid
  stockSupplyId String      @db.Uuid
  createdAt     DateTime    @default(now())
  department    Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  stockSupply   StockSupply @relation(fields: [stockSupplyId], references: [id], onDelete: Cascade)

  @@unique([departmentId, stockSupplyId])
}

model StockFulfillment {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stockRequestId String                 @db.Uuid
  fulfilledById  String                 @db.Uuid
  notes          String?
  createdAt      DateTime               @default(now())
  fulfilledBy    User                   @relation(fields: [fulfilledById], references: [id])
  stockRequest   StockRequest           @relation(fields: [stockRequestId], references: [id], onDelete: Cascade)
  items          StockFulfillmentItem[]
}

model StockFulfillmentItem {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stockFulfillmentId String           @db.Uuid
  stockRequestItemId String           @db.Uuid
  quantityDelivered  Decimal          @db.Decimal(12, 2)
  createdAt          DateTime         @default(now())
  stockFulfillment   StockFulfillment @relation(fields: [stockFulfillmentId], references: [id], onDelete: Cascade)
  stockRequestItem   StockRequestItem @relation(fields: [stockRequestItemId], references: [id])
}

model CookingRecord {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stockSupplyId     String                @db.Uuid
  quantityCooked    Decimal               @db.Decimal(12, 2)
  platesExpected    Decimal               @db.Decimal(12, 2)
  cookedById        String                @db.Uuid
  notes             String?
  createdAt         DateTime              @default(now())
  cookedDate        DateTime              @default(now()) @db.Date
  platesActual      Decimal?              @db.Decimal(12, 2)
  cookedBy          User                  @relation(fields: [cookedById], references: [id])
  stockSupply       StockSupply           @relation(fields: [stockSupplyId], references: [id])
  cookingRecordMenus CookingRecordMenu[]
}

model CookingRecordMenu {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cookingRecordId   String         @db.Uuid
  menuId            String         @db.Uuid
  platesAllocated   Decimal        @db.Decimal(12, 2)
  platesRemaining   Decimal        @default(0) @db.Decimal(12, 2)
  createdAt         DateTime       @default(now())
  cookingRecord     CookingRecord  @relation(fields: [cookingRecordId], references: [id], onDelete: Cascade)
  menu              Menu           @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([cookingRecordId, menuId])
}
model StockSupplyMenu {
  stockSupplyId String      @db.Uuid
  menuId        String      @db.Uuid
  menu          Menu        @relation(fields: [menuId], references: [id], onDelete: Cascade)
  stockSupply   StockSupply @relation(fields: [stockSupplyId], references: [id])

  @@id([stockSupplyId, menuId])
}

model Shift {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type            ShiftType
  date            DateTime        @db.Date
  openingTime       DateTime
  autoCloseTime     DateTime
  actualOpeningTime DateTime?      @db.Timestamp(6)
  actualCloseTime   DateTime?      @db.Timestamp(6)
  isOpen          Boolean         @default(true)
  openedById      String          @db.Uuid
  closedById      String?         @db.Uuid
  createdAt       DateTime        @default(now()) @db.Timestamp(6)
  openedBy        User            @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  closedBy        User?           @relation("ShiftClosedBy", fields: [closedById], references: [id])
  snapshots       ShiftSnapshot[]
  orders          Order[]

  @@unique([type, date])
}

model ShiftSnapshot {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shiftId       String @db.Uuid
  menuId        String @db.Uuid
  openingPlates Int
  closingPlates Int?
  platesSold    Int    @default(0)
  platesWasted  Int    @default(0)
  shift         Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  menu          Menu   @relation(fields: [menuId], references: [id])

  @@unique([shiftId, menuId])
}

enum ServiceTime {
  BREAKFAST
  LUNCH
  DINNER
  DESSERT
  BEVERAGE
}

enum ShiftType {
  DAY
  NIGHT
}

enum AccompanimentType {
  STARCH
  VEGETABLE
}

enum ItemUnit {
  KG
  PKT
  L
  ML
  PCS
}

enum StockRequestStatus {
  PENDING
  PARTIAL
  COMPLETED
}
